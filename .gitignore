# Sistema operativo
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editores: estado local
.idea/
*.iml
*.iws
*.swp
*.swo
*.swn
*~
.history/

# VS Code: solo configuracion compartible conocida
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Secretos y configuracion local
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
*.p12
*.pfx
*.key
*-private.pem
secrets.*
credentials.*
!secrets.example
!secrets.example.*
!secrets.*.example
!credentials.example
!credentials.example.*
!credentials.*.example

# Temporales. Los documentos, PDF, imagenes y ZIP no se ignoran.
*.log
*.tmp
*.temp
*.bak
~$*
.~lock.*#
*.db-journal
*.sqlite-journal
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Los JAR deliberados se conservan; las salidas se regulan por directorio.
!**/*.jar
